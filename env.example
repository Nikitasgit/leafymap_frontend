# API Configuration
# Browser (and local npm run dev): host-published API port
NEXT_PUBLIC_API_URL=http://localhost:5002
# Next.js server-side fetches when the frontend runs in Docker (compose service name)
# API_URL=http://api:5002

# Mapbox Configuration
# Get your Mapbox access token from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token_here
