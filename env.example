# API Configuration
# Host `npm run dev`: same port as backend PORT (env.example backend = 5001).
NEXT_PUBLIC_API_URL=http://localhost:5001
# Docker Compose overrides this to http://localhost:5002 for the browser,
# and sets API_URL=http://api:5002 for Next.js server-side fetches.
# Do not set API_URL on Vercel.
# API_URL=http://api:5002

# Mapbox Configuration
# Get your Mapbox access token from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token_here

# Google OAuth — same Client ID as backend GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
